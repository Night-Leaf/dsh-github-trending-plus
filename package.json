{
  "name": "dsh-github-trending-plus",
  "version": "2.0.0",
  "type": "module",
  "description": "GitHub Trending radar: fetch daily/weekly/monthly boards, analyze every repository, and render an interactive card report inside the Harness Web UI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Night-Leaf/dsh-github-trending-plus"
  },
  "homepage": "https://github.com/Night-Leaf/dsh-github-trending-plus",
  "bugs": {
    "url": "https://github.com/Night-Leaf/dsh-github-trending-plus"
  },
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "cordis",
    "plugin",
    "github-trending",
    "bundle"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "cordis.patch.yml",
    "cordis.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "screenshots.json"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
